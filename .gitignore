# Arquivos pessoais do usuario — NUNCA sobem pro repo publico
# Squads sao sempre pessoais. Templates oficiais vivem em bases/_template/.
/squads/
/bases/*

# Excecao: manter os templates vazios pra quem clona
!/bases/_template/

# Credenciais e env (mas .env.example pode ser commitado como template)
.env
.env.*
!.env.example
*.secrets
*.pem
*.key

# Arquivos locais de trabalho
*.local.md
*.local.json
*.draft.md
*.scratch.*

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
.cursor/

# Python (notebooklm-py etc)
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
*.egg-info/

# Node (vibe coding)
node_modules/
.next/
dist/
build/

# Logs
*.log
npm-debug.log*
.sync-hub-last
